# Copie para .env  (docker compose lê automaticamente). Nada aqui é obrigatório.
POSTGRES_PASSWORD=sinpin
SINPIN_SEED_DEMO=1

# --- IA generativa (opcional; sem isto o sistema responde em modo extrativo, sem LLM) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ou um servidor compatível com OpenAI (Ollama/vLLM):
# SINPIN_LLM_PROVIDER=openai_compat
# SINPIN_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# SINPIN_LLM_MODEL=<modelo>

# --- Busca vetorial (opcional; sem isto a busca é só lexical) ---
# Exemplo com Ollama local:  ollama pull nomic-embed-text
# SINPIN_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# SINPIN_EMBEDDING_MODEL=nomic-embed-text
# SINPIN_EMBEDDING_DIM=768
# ATENÇÃO: com provedor de embeddings REMOTO, o texto de documentos restritos sai da infraestrutura do órgão.
